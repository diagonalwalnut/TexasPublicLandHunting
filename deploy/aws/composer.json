{
    "name": "tplh/tier4-api",
    "description": "Texas Public Land Hunting accounts API (PHP/Bref on Lambda + DynamoDB).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-sodium": "*",
        "bref/bref": "^2.1",
        "aws/aws-sdk-php": "^3.300"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "bref/bref": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
