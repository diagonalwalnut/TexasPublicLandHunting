# HostGator / Apache for Texas Public Land Hunting
# Copied into dist/ by Vite (from web/public/).

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^api/data/ - [F]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Failed FTP often leaves api/index.php missing or 0 bytes. Route the
  # accounts probe through accounts.php so it can restore those files.
  RewriteCond %{DOCUMENT_ROOT}/api/index.php !-s
  RewriteRule ^api/index\.php$ accounts.php [L,QSA]
  RewriteCond %{DOCUMENT_ROOT}/data/drawn_hunts.json !-s
  RewriteRule ^data/drawn_hunts\.json$ drawn_payload.php?name=hunts [L,QSA]
  RewriteCond %{DOCUMENT_ROOT}/data/drawn_meta.json !-s
  RewriteRule ^data/drawn_meta\.json$ drawn_payload.php?name=meta [L,QSA]
  RewriteCond %{DOCUMENT_ROOT}/data/drawn_hunts.geojson !-s
  RewriteRule ^data/drawn_hunts\.geojson$ drawn_payload.php?name=geo [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_mime.c>
  AddType application/geo+json .geojson
  AddType application/json .json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType application/geo+json "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/geo+json
</IfModule>
