# Copy to web/.env.local for local development. Never commit real keys.
# The anon key is safe to embed in a static build; row-level security protects data.
# Do NOT put the service_role key here or anywhere in this repository.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
