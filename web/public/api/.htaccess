DirectoryIndex index.php

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data/ - [F]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "\.(sqlite|sqlite-journal|sqlite-wal|sqlite-shm|key)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
